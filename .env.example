# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed.
#   cp .env.example .env       (bash)
#   Copy-Item .env.example .env  (PowerShell)
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
PGUSER=postgres
# IMPORTANT: set this to your local postgres user's password
PGPASSWORD=CHANGE_ME
PGDATABASE=fems
PGHOST=localhost
PGPORT=5432
# Used by services + migration scripts.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/fems

# --- JWT / auth ---
JWT_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Gateway / CORS ---
GATEWAY_PORT=8080
CORS_ORIGIN=*
NODE_ENV=development

# --- Notification reminders / alerts (notification-service) ---
# Background sweeper runs every N minutes and generates reminder-style notifications.
NOTIFICATION_SWEEPER_ENABLED=true
# Minimum is 10 minutes.
NOTIFICATION_SWEEPER_INTERVAL_MINUTES=10
# "Expiring soon" window
EXPIRY_ALERT_DAYS=30
# Upcoming inspection reminder window
INSPECTION_REMINDER_DAYS=3
# If an extinguisher is in maintenance and has no recent maintenance logs, remind.
MAINTENANCE_REMINDER_DAYS=14
# Daily compliance summary to admins
COMPLIANCE_SUMMARY_ENABLED=true

# --- Frontend (Next.js) ---
# Browser talks to the gateway:
NEXT_PUBLIC_API_URL=http://localhost:8080/api
